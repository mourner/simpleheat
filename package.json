{
  "name": "simpleheat",
  "version": "0.4.0",
  "description": "A tiny JavaScript library for drawing heatmaps with Canvas",
  "homepage": "https://github.com/mourner/simpleheat",
  "keywords": [
    "heatmap",
    "canvas",
    "visualization"
  ],
  "author": "Volodymyr Agafonkin",
  "repository": {
    "type": "git",
    "url": "git://github.com/mourner/simpleheat.git"
  },
  "type": "module",
  "main": "simpleheat.js",
  "types": "simpleheat.d.ts",
  "exports": {
    ".": {
      "types": "./simpleheat.d.ts",
      "default": "./simpleheat.js"
    }
  },
  "files": [
    "simpleheat.js",
    "simpleheat.d.ts"
  ],
  "scripts": {
    "lint": "eslint simpleheat.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run lint && npm run typecheck",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "eslint-config-mourner": "^5.0.1",
    "typescript": "^7.0.2"
  },
  "license": "BSD-2-Clause"
}
